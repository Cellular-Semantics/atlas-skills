.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local eval scratch: the picks cache (picks are the thing under test, so they
# are not committed) and timestamped run directories. Obs profiles are NOT here
# -- they are committed fixtures under evals/fixtures/profiles/, so re-scoring
# the picker needs no network.
evals/.cache/
evals/results/

# onto-query: throwaway venv for local test runs
.venv/
# cached ontology authority for evals/ontology-mapping/verify-hsapdv-claims.py
evals/ontology-mapping/.hsapdv-authority.json
# cached ontology authority for evals/ontology-mapping/verify-ehdaa2-claims.py
docs/archive/ehdaa2-investigation/.ehdaa2-authority.json
# regenerated by evals/ontology-mapping/sweep-hdca-corpus.py
docs/archive/ehdaa2-investigation/sweep-latest.json

# Eval run outputs: transcripts are large, regenerable, and contain full
# agent reasoning. The derived review TSV is committed; these are not.
evals/ontology-mapping/runs/transcripts/
evals/ontology-mapping/runs/*.json
.DS_Store

# Per-worker slice files are scratch for a particular parallel run; the named
# slices (slice-20.txt, slice-50.txt) are the ones worth keeping.
evals/ontology-mapping/s50-*.txt
evals/ontology-mapping/slice-*-p[0-9].txt
